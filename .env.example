# NEXORA environment
#
# Leave VITE_AGENT_ENDPOINT unset to run the built-in local simulation.
# For a hosted/backend agent, point it at an endpoint that speaks the NEXORA
# SSE/NDJSON/JSON AgentEvent protocol.
#
# VITE_AGENT_ENDPOINT=http://localhost:8787/api/agent
#
# For a free local model, run Ollama and the local bridge instead:
#
#   ollama pull llama3.2
#   npm run agent:ollama
#
# Then enable "Local model (Ollama)" in Settings. No API key required.
# Optional: default Ollama base URL for server/ollama-agent.mjs
# OLLAMA_URL=http://localhost:11434
